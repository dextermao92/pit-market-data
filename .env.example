# Copy to .env (gitignored) and fill in.
# Paper (default): the paper-trading username. Live: set TRADING_MODE=live and IB_PORT=4003 below.
TWS_USERID=
TWS_PASSWORD=
# Optional: set to enable VNC on 127.0.0.1:5900 (to see the Gateway UI, e.g. for 2FA).
VNC_SERVER_PASSWORD=
# Optional: if the user has several 2FA devices, the one to use, spelled exactly as in the Gateway's list.
TWOFA_DEVICE=

# --- Alpaca (stock/ETF 15-min bars) ---
# Free account at alpaca.markets -> Paper Trading dashboard -> API Keys -> Generate.
# Paper keys are fine: market data is the same, and they cannot touch real money.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# --- IB Gateway mode ---
TRADING_MODE=paper
IB_PORT=4004

# --- Alerts: Discord webhook and/or email (Gmail: SMTP_PASSWORD is an app password) ---
DISCORD_WEBHOOK_URL=
ALERT_EMAIL_TO=
SMTP_USER=
SMTP_PASSWORD=
