# The Copilot's HTTP API (pit.copilot.api), apart from the Airflow image: its packages (openai, mcp, fastapi) never
# touch the collector's. Code, config and ops docs are mounted (docker-compose.yml, service api), like airflow's.
FROM python:3.12.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.13.1 /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1
COPY pyproject.toml uv.lock ./
# dev for duckdb (the docs index is built on it); no dbt
RUN uv sync --locked --no-install-project --no-default-groups --group copilot --group api --group dev \
    && rm -rf /root/.cache
ENV PATH=/opt/venv/bin:$PATH PYTHONPATH=/app/src DATA_DIR=/app/data PIT_COPILOT_NO_ACTIONS=1
EXPOSE 8000
CMD ["uvicorn", "pit.copilot.api:app", "--host", "0.0.0.0", "--port", "8000"]
